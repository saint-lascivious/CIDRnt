write_output() {

    if [ -z "$OUTPUT_FILE" ] || [ "$OUTPUT_FILE" = "-" ]; then

        generate_output

        return
    fi

    case "$OUTPUT_FILE" in
        */*)
            outdir=${OUTPUT_FILE%/*}

