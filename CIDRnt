    for provider in $RIR_NAMES; do
        provider_url_result=$(provider_url "$provider")

        case "$provider_url_result" in
            https://*)

                self_test_pass "provider_url ($provider)"

                ;;
            *)

                self_test_fail \
                    "provider_url ($provider)" \
                    "unexpected URL: $provider_url_result"

                ;;
        esac

    done

    self_test_section "provider fetching and cache"

    saved_cache_dir=$CACHE_DIR
    saved_cache_ttl=$CACHE_TTL_SECONDS
    CACHE_DIR="$TMPDIR/test-cache"
    CACHE_TTL_SECONDS=604800

    mkdir -p "$CACHE_DIR"

    printf '%s\n' "old cached data" > "$CACHE_DIR/delegated-apnic-latest"
    printf '%s\n' 1 > "$CACHE_DIR/delegated-apnic-latest.epoch"

    curl() {
        return 22
    }

    fetch_provider apnic 2> "$TMPDIR/cache_fallback.warning"

    unset -f curl

    printf 'warning: apnic: download from %s failed, using cached data\n' "$(provider_url apnic)" > "$TMPDIR/cache_fallback_warning.want"

    self_test_diff \
        "failed download warns about cache fallback" \
        "$TMPDIR/cache_fallback_warning.want" \
        "$TMPDIR/cache_fallback.warning" || fail=1

    printf '%s\n' "old cached data" > "$TMPDIR/cache_fallback.want"

    self_test_diff \
        "failed download uses cached data" \
        "$TMPDIR/cache_fallback.want" \
        "$TMPDIR/delegated-apnic" || fail=1

    self_test_diff \
        "failed download does not overwrite cache" \
        "$TMPDIR/cache_fallback.want" \
        "$CACHE_DIR/delegated-apnic-latest" || fail=1

    cached_stamp=$(cat "$CACHE_DIR/delegated-apnic-latest.epoch")

    self_test_assert_eq \
        "failed download does not refresh cache timestamp" \
        "$cached_stamp" \
        "1" \
        "cache timestamp"

    date +%s > "$CACHE_DIR/delegated-apnic-latest.epoch"

    rm -f "$TMPDIR/curl-called"

    curl() {
        : > "$TMPDIR/curl-called"
        return 22
    }

    fetch_provider apnic

    if [ -e "$TMPDIR/curl-called" ]; then

        self_test_fail \
            "fresh cache avoids network fetch" \
            "curl was called despite a fresh cache"

    else

        self_test_pass "fresh cache avoids network fetch"

    fi

    REFRESH_CACHE=1

    rm -f "$TMPDIR/curl-called"

    fetch_provider apnic 2> "$TMPDIR/refresh_fallback.warning"

    unset -f curl
    REFRESH_CACHE=0

    if [ -e "$TMPDIR/curl-called" ]; then

        self_test_pass "--refresh bypasses fresh cache"

    else

        self_test_fail \
            "--refresh bypasses fresh cache" \
            "curl was not called despite --refresh"

    fi

    self_test_diff \
        "--refresh warns about cache fallback" \
        "$TMPDIR/cache_fallback_warning.want" \
        "$TMPDIR/refresh_fallback.warning" || fail=1

    self_test_diff \
        "--refresh still falls back when download fails" \
        "$TMPDIR/cache_fallback.want" \
        "$TMPDIR/delegated-apnic" || fail=1

    printf '%s\n' 1 > "$CACHE_DIR/delegated-apnic-latest.epoch"

    curl() {
        printf '%s\n' "apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated"
    }

    fetch_provider apnic

    unset -f curl

    cat > "$TMPDIR/cache_refresh.want" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
EOF

    self_test_diff \
        "successful download is used" \
        "$TMPDIR/cache_refresh.want" \
        "$TMPDIR/delegated-apnic" || fail=1

    self_test_diff \
        "successful download updates cache" \
        "$TMPDIR/cache_refresh.want" \
        "$CACHE_DIR/delegated-apnic-latest" || fail=1

    refreshed_stamp=$(cat "$CACHE_DIR/delegated-apnic-latest.epoch")

    if [ "$refreshed_stamp" != "1" ]; then

        self_test_pass "successful download refreshes cache timestamp"

    else

        self_test_fail \
            "successful download refreshes cache timestamp" \
            "cache timestamp still $refreshed_stamp"

    fi

    rm -f "$CACHE_DIR/delegated-apnic-latest" "$CACHE_DIR/delegated-apnic-latest.epoch"

    curl() {
        return 22
    }

    if ( fetch_provider apnic ) 2>/dev/null; then

        self_test_fail \
            "failed download without cache is fatal" \
            "fetch_provider unexpectedly succeeded"

    else

        self_test_pass "failed download without cache is fatal"

    fi

    unset -f curl

    CACHE_DIR=$saved_cache_dir
    CACHE_TTL_SECONDS=$saved_cache_ttl

    self_test_section "status and family filters"

    parse_locales NZ

    self_test_reset_parse_state

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
apnic|NZ|ipv4|1.0.1.0|256|20200101|assigned
EOF

    STATUS_MODE="allocated-only"
    FAMILY_MODE="all"

    extract_cidrs | sort > "$TMPDIR/allocated_only_filter.got"

    cat > "$TMPDIR/allocated_only_filter.want" <<'EOF'
1.0.0.0/24
EOF

    self_test_diff \
        "allocated-only filter" \
        "$TMPDIR/allocated_only_filter.want" \
        "$TMPDIR/allocated_only_filter.got" || fail=1

    STATUS_MODE="allocated-and-assigned"
    FAMILY_MODE="all"

    extract_cidrs | sort > "$TMPDIR/allocated_and_assigned_filter.got"

    cat > "$TMPDIR/allocated_and_assigned_filter.want" <<'EOF'
1.0.0.0/24
1.0.1.0/24
EOF

    self_test_diff \
        "allocated-and-assigned filter" \
        "$TMPDIR/allocated_and_assigned_filter.want" \
        "$TMPDIR/allocated_and_assigned_filter.got" || fail=1

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
apnic|NZ|ipv6|2001:db8::|32|20200101|allocated
EOF

    STATUS_MODE="allocated-only"
    FAMILY_MODE="ipv4"

    extract_cidrs | sort > "$TMPDIR/ipv4_only.got"

    cat > "$TMPDIR/ipv4_only.want" <<'EOF'
1.0.0.0/24
EOF

    self_test_diff \
        "ipv4-only filter" \
        "$TMPDIR/ipv4_only.want" \
        "$TMPDIR/ipv4_only.got" || fail=1

    STATUS_MODE="allocated-only"
    FAMILY_MODE="ipv6"

    extract_cidrs | sort > "$TMPDIR/ipv6_only.got"

    cat > "$TMPDIR/ipv6_only.want" <<'EOF'
2001:db8::/32
EOF

    self_test_diff \
        "ipv6-only filter" \
        "$TMPDIR/ipv6_only.want" \
        "$TMPDIR/ipv6_only.got" || fail=1

    self_test_section "multiple registries"

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
arin|AU|ipv4|2.0.0.0|256|20200101|allocated
EOF

    parse_locales NZ AU
    STATUS_MODE="allocated-only"
    FAMILY_MODE="all"

    extract_cidrs | sort > "$TMPDIR/multiple_registries.got"

    cat > "$TMPDIR/multiple_registries.want" <<'EOF'
1.0.0.0/24
2.0.0.0/24
EOF

    self_test_diff \
        "records from multiple registries" \
        "$TMPDIR/multiple_registries.want" \
        "$TMPDIR/multiple_registries.got" || fail=1

    list_locales > "$TMPDIR/multiple_registry_locales.got"

    cat > "$TMPDIR/multiple_registry_locales.want" <<'EOF'
AU
NZ
EOF

    self_test_diff \
        "locales from multiple registries" \
        "$TMPDIR/multiple_registry_locales.want" \
        "$TMPDIR/multiple_registry_locales.got" || fail=1

    self_test_section "locale listing"

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
apnic|AU|ipv4|1.0.1.0|256|20200101|allocated
apnic|NC|ipv4|1.0.2.0|256|20200101|allocated
arin|US|ipv4|2.0.0.0|256|20200101|allocated
EOF

    list_locales n > "$TMPDIR/list_locales_filter.got"

    cat > "$TMPDIR/list_locales_filter.want" <<'EOF'
NC
NZ
EOF

    self_test_diff \
        "list locales filtered by leading letter (case insensitive)" \
        "$TMPDIR/list_locales_filter.want" \
        "$TMPDIR/list_locales_filter.got" || fail=1

    self_test_section "formatting and output"

    cat > "$TMPDIR/minimise_ipv6.in" <<'EOF'
2001:0db8:0000:0000:0000:0000:0000:0000/32
2001:0db8:0000:0000:0000:0000:0000:0001/128
1.2.3.0/24
EOF

    cat > "$TMPDIR/minimise_ipv6.want" <<'EOF'
2001:db8::/32
2001:db8::1/128
1.2.3.0/24
EOF

    minimise_ipv6_cidrs < "$TMPDIR/minimise_ipv6.in" > "$TMPDIR/minimise_ipv6.got"

    self_test_diff \
        "ipv6 minimization" \
        "$TMPDIR/minimise_ipv6.want" \
        "$TMPDIR/minimise_ipv6.got" || fail=1

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
EOF

    STATUS_MODE="allocated-only"
    FAMILY_MODE="all"
    OUTPUT_FILE="$TMPDIR/out/file_output.txt"
    MINIMISE_IPV6=0

    write_output

    cat > "$TMPDIR/file_output.want" <<'EOF'
1.0.0.0/24
EOF

    self_test_diff \
        "file output" \
        "$TMPDIR/file_output.want" \
        "$OUTPUT_FILE" || fail=1

    self_test_section "aggregation and decomposition"

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|1.0.0.0|256|20200101|allocated
EOF

    self_test_reset_parse_state

    parse_args NZ -c "1.0.1.0/24" --custom "2001:db8::/32"

    if [ -s "$ARGS_FILE" ]; then
        # shellcheck disable=SC2046
        set -- $(cat "$ARGS_FILE")
    else
        set --
    fi

    parse_locales "$@"

    prepare_custom_cidrs

    STATUS_MODE="allocated-only"
    FAMILY_MODE="all"

    generate_output > "$TMPDIR/custom_integration.got"

    cat > "$TMPDIR/custom_integration.want" <<'EOF'
1.0.0.0/23
2001:0db8:0000:0000:0000:0000:0000:0000/32
EOF

    self_test_diff \
        "custom CIDRs integrated into pipeline" \
        "$TMPDIR/custom_integration.want" \
        "$TMPDIR/custom_integration.got" || fail=1

    cat > "$TMPDIR/aggregate_and_sort.in" <<'EOF'
10.0.0.0/24
10.0.1.0/24
10.0.2.0/24
10.0.3.0/24
10.0.0.0/25
2001:db8::/33
2001:db8:8000::/33
EOF

    cat > "$TMPDIR/aggregate_and_sort.want" <<'EOF'
10.0.0.0/22
2001:0db8:0000:0000:0000:0000:0000:0000/32
EOF

    aggregate_with_awk < "$TMPDIR/aggregate_and_sort.in" | sort_cidrs_natural > "$TMPDIR/aggregate_and_sort.got"

    self_test_diff \
        "aggregation pipeline" \
        "$TMPDIR/aggregate_and_sort.want" \
        "$TMPDIR/aggregate_and_sort.got" || fail=1

    cat > "$TMPDIR/delegated" <<'EOF'
apnic|NZ|ipv4|10.0.0.0|768|20200101|allocated
EOF

    STATUS_MODE="allocated-only"
    FAMILY_MODE="all"

    extract_cidrs | sort > "$TMPDIR/ipv4_range_decomposition.got"

    cat > "$TMPDIR/ipv4_range_decomposition.want" <<'EOF'
10.0.0.0/23
10.0.2.0/24
EOF

    self_test_diff \
        "ipv4 range decomposition" \
        "$TMPDIR/ipv4_range_decomposition.want" \
        "$TMPDIR/ipv4_range_decomposition.got" || fail=1

    if [ "$fail" -eq 0 ]; then
        printf '\nself-test: PASS\n'
        return 0
    fi

    printf '\nself-test: FAIL\n' >&2
    return 1
}

main() {

    mkdir -p "$TMPDIR"

    parse_args "$@"

    if [ "$RUN_SELF_TEST" -eq 1 ]; then

        self_test

        exit $?
    fi

    if [ "$LIST_LOCALES" -eq 1 ]; then

        # shellcheck disable=SC2086
        fetch_providers $RIR_NAMES

        list_locales > "$TMPDIR/locale-list"

        locale_total=$(awk 'END { print NR + 0 }' "$TMPDIR/locale-list")

        if [ -n "$LIST_LOCALES_FILTER" ]; then

            list_locales "$LIST_LOCALES_FILTER" > "$TMPDIR/locale-list.filtered"

            locale_shown=$(awk 'END { print NR + 0 }' "$TMPDIR/locale-list.filtered")

            cat "$TMPDIR/locale-list.filtered"

            printf "locales beginning with '%s': %d of %d\n" "$LIST_LOCALES_FILTER" "$locale_shown" "$locale_total" >&2

        else

            cat "$TMPDIR/locale-list"

            printf 'total locales: %d\n' "$locale_total" >&2

        fi

        exit 0
    fi

    if [ -s "$ARGS_FILE" ]; then
        # shellcheck disable=SC2046
        set -- $(cat "$ARGS_FILE")
    else
        set --
    fi

    parse_locales "$@"

    prepare_custom_cidrs

    providers=$(select_providers)

    [ -n "$providers" ] || die "no RIR providers selected"

    # shellcheck disable=SC2086
    fetch_providers $providers

    write_output

}

main "$@"
