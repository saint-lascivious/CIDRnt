            ;;
    esac

    generate_output > "$OUTPUT_FILE"

}

parse_args() {

    ARGS_FILE="$TMPDIR/args"
    CUSTOM_ARGS_FILE="$TMPDIR/custom_args"

    : > "$ARGS_FILE"
    : > "$CUSTOM_ARGS_FILE"

    while [ "$#" -gt 0 ]; do

        case "$1" in
            -a|--allocated-only)
                STATUS_MODE="allocated-only"
                shift
                ;;
            -A|--allocated-and-assigned)
                STATUS_MODE="allocated-and-assigned"
                shift
                ;;
            -c|--custom)

                [ "$#" -ge 2 ] || usage_error "missing argument for $1"

                [ -n "$2" ] || usage_error "missing argument for $1"

                printf '%s\n' "$2" >> "$CUSTOM_ARGS_FILE"
                shift 2
                ;;
            -c=*|--custom=*)
                custom_arg=${1#*=}

                [ -n "$custom_arg" ] || usage_error "missing argument for ${1%%=*}"

                printf '%s\n' "$custom_arg" >> "$CUSTOM_ARGS_FILE"
                shift
                ;;
            -h|--help)

                usage

                exit 0
                ;;
            -i|--ipv4-only)

                [ "$FAMILY_MODE" = "all" ] || usage_error "conflicting family options: --ipv4-only and --ipv6-only"

                FAMILY_MODE="ipv4"
                shift
                ;;
            -I|--ipv6-only)

                [ "$FAMILY_MODE" = "all" ] || usage_error "conflicting family options: --ipv4-only and --ipv6-only"

                FAMILY_MODE="ipv6"
                shift
                ;;
            -l|--locale|--locales)

                [ "$#" -ge 2 ] || usage_error "missing argument for $1"

                [ -n "$2" ] || usage_error "missing argument for $1"

                printf '%s\n' "$2" >> "$ARGS_FILE"
                shift 2
                ;;
            -l=*|--locale=*|--locales=*)
                locale_arg=${1#*=}

                [ -n "$locale_arg" ] || usage_error "missing argument for ${1%%=*}"

                printf '%s\n' "$locale_arg" >> "$ARGS_FILE"
                shift
                ;;
            -L|--list|--list-locales)
                LIST_LOCALES=1
                shift

                case "${1:-}" in
                    [A-Za-z])
                        LIST_LOCALES_FILTER=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
                        shift
                        ;;
                esac

                ;;
            -L=*|--list=*|--list-locales=*)
                LIST_LOCALES=1
                LIST_LOCALES_FILTER=${1#*=}

                case "$LIST_LOCALES_FILTER" in
                    '')
                        ;;
                    [A-Za-z])
                        LIST_LOCALES_FILTER=$(printf '%s' "$LIST_LOCALES_FILTER" | tr '[:lower:]' '[:upper:]')
                        ;;
                    *)

                        usage_error "invalid locale filter: $LIST_LOCALES_FILTER (expected a single letter)"

                        ;;
                esac

                shift
                ;;
            -m|--minimise-ipv6|--minimize-ipv6)
                MINIMISE_IPV6=1
                shift
                ;;
            -o|--output)

                [ "$#" -ge 2 ] || usage_error "missing argument for $1"

                OUTPUT_FILE=$2
                shift 2
                ;;
            --output=*)
                OUTPUT_FILE=${1#--output=}

                [ -n "$OUTPUT_FILE" ] || usage_error "missing argument for --output"

                shift
                ;;
            -r|--refresh)
                REFRESH_CACHE=1
                shift
                ;;
            -s|--self-test)
                RUN_SELF_TEST=1
                shift
                ;;
            -v|--version)
                printf 'CIDRnt v%s\n' "$VERSION-$BRANCH"
                exit 0
                ;;
            --)
                shift

                while [ "$#" -gt 0 ]; do
                    printf '%s\n' "$1" >> "$ARGS_FILE"
                    shift
                done

                break
                ;;
            -*)

                usage_error "unknown option: $1"

                ;;
            *)
                printf '%s\n' "$1" >> "$ARGS_FILE"
                shift
                ;;
        esac

    done

}

prepare_custom_cidrs() {

    CUSTOM_CIDRS_FILE="$TMPDIR/custom.cidrs"

    : > "$CUSTOM_CIDRS_FILE"

    [ -s "$CUSTOM_ARGS_FILE" ] || return 0

    CUSTOM_EXPANDED_ARGS_FILE="$TMPDIR/custom.args.expanded"

    : > "$CUSTOM_EXPANDED_ARGS_FILE"

    while IFS= read -r line || [ -n "$line" ]; do

        [ -n "$line" ] || continue

        if [ -f "$line" ] && [ -r "$line" ]; then

            while IFS= read -r entry || [ -n "$entry" ]; do

                [ -n "$entry" ] || continue

                printf '%s\n' "$entry" >> "$CUSTOM_EXPANDED_ARGS_FILE"
            done < "$line"

        else
            printf '%s\n' "$line" >> "$CUSTOM_EXPANDED_ARGS_FILE"
        fi

    done < "$CUSTOM_ARGS_FILE"

    awk '

        function is_h16(x) { return (x ~ /^[0-9a-f]{1,4}$/) }

        function valid_ipv4(ip, a, i, o) {

            if (split(ip, a, ".") != 4) return 0

            for (i = 1; i <= 4; i++) {
                o = a[i]

                if (o !~ /^[0-9]+$/) return 0

                o += 0

                if (o < 0 || o > 255) return 0

            }

            return 1
        }

        function valid_ipv6(ip, lower, n, left, right, lcnt, rcnt, miss, i, parts, la, ra) {
            lower = tolower(ip)

            if (index(lower, ".") > 0) return 0

            n = split(lower, parts, "::")

            if (n > 2) return 0

            left = parts[1]
            right = (n == 2 ? parts[2] : "")

            lcnt = 0

            if (left != "") lcnt = split(left, la, ":")

            rcnt = 0

            if (right != "") rcnt = split(right, ra, ":")

            if (n == 1) {

                if (lcnt != 8) return 0

                miss = 0
            } else {
                miss = 8 - (lcnt + rcnt)

                if (miss < 1) return 0

            }

            for (i = 1; i <= lcnt; i++) if (!is_h16(la[i])) return 0

            for (i = 1; i <= rcnt; i++) if (!is_h16(ra[i])) return 0

            return 1
        }

        function bad(tok) {
            printf "invalid custom IP/CIDR: %s\n", tok > "/dev/stderr"
            err = 1
        }

        function emit(tok, n, t, ip, p) {

            if (tok == "") return

            if (index(tok, "/") > 0) {
                n = split(tok, t, "/")

                if (n != 2 || t[2] !~ /^[0-9]+$/) { bad(tok); return }

                ip = t[1]
                p = t[2] + 0

                if (index(ip, ".") > 0) {

                    if (!valid_ipv4(ip) || p < 0 || p > 32) { bad(tok); return }

                    print ip "/" p
                    return
                }

                if (index(ip, ":") > 0) {

                    if (!valid_ipv6(ip) || p < 0 || p > 128) { bad(tok); return }

                    print tolower(ip) "/" p
                    return
                }

                bad(tok)
                return
            }

            if (index(tok, ".") > 0) {

                if (!valid_ipv4(tok)) { bad(tok); return }

                print tok "/32"
                return
            }

            if (index(tok, ":") > 0) {

                if (!valid_ipv6(tok)) { bad(tok); return }

                print tolower(tok) "/128"
                return
            }

            bad(tok)
        }

        {
            n = split($0, a, /[[:space:],;]+/)

            for (i = 1; i <= n; i++) emit(a[i])

        }

        END {

            if (err) exit 1

        }

    ' "$CUSTOM_EXPANDED_ARGS_FILE" > "$TMPDIR/custom.cidrs.tmp" || die "failed parsing custom IP/CIDR input"

    awk '!seen[$0]++' "$TMPDIR/custom.cidrs.tmp" > "$CUSTOM_CIDRS_FILE"

}

self_test() {

    self_test_diff() {

        label=$1
        want=$2
        got=$3

        if diff -u "$want" "$got" >/dev/null 2>&1; then
            printf 'ok  - %s\n' "$label"
            return 0
        fi

        printf 'not ok - %s\n' "$label" >&2

        diff -u "$want" "$got" >&2 || true

        return 1

    }

    self_test_reset_parse_state() {
        CUSTOM_ARGS_FILE=""
        CUSTOM_CIDRS_FILE=""
        FAMILY_MODE="all"
        LIST_LOCALES=0
        LIST_LOCALES_FILTER=""
        MINIMISE_IPV6=0
        OUTPUT_FILE=""
        REFRESH_CACHE=0
        RUN_SELF_TEST=0
        STATUS_MODE="allocated-and-assigned"
    }

    self_test_section() {
        printf '\n%s:\n' "$1"
    }

    self_test_pass() {
        printf 'ok  - %s\n' "$1"
    }

    self_test_fail() {
        label=$1
        shift
        printf 'not ok - %s\n' "$label" >&2

        while [ "$#" -gt 0 ]; do
            printf '%s\n' "$1" >&2
            shift
        done

        fail=1
    }

    self_test_assert_eq() {
        label=$1
        got=$2
        want=$3
        key=${4:-value}

        if [ "$got" = "$want" ]; then

            self_test_pass "$label"

        else

            self_test_fail "$label" "got:  $key=$got" "want: $key=$want"

        fi

    }

    self_test_parse_state() {
        label=$1
        varname=$2
        want=$3
        shift 3

        self_test_reset_parse_state

        parse_args "$@"

        eval "got=\${$varname}"

        self_test_assert_eq "$label" "$got" "$want" "$varname"

    }

    self_test_assert_usage() {
        label=$1
        shift

        if out=$( (parse_args "$@") 2>&1 ); then

            if printf '%s\n' "$out" | awk 'BEGIN{ok=0} /^Usage:/{ok=1} END{exit(ok?0:1)}'; then

                self_test_pass "$label"

            else

                self_test_fail "$label" "$out"

            fi

        else

            self_test_fail "$label"

        fi

    }

    self_test_assert_usage_error() {
        label=$1
        shift

        rc=0

        out=$( (parse_args "$@") 2>&1 ) || rc=$?

        if [ "$rc" -eq 2 ] && printf '%s\n' "$out" | awk 'BEGIN{ok=0} /^Usage:/{ok=1} END{exit(ok?0:1)}'; then

            self_test_pass "$label"

        else

            self_test_fail "$label" "exit=$rc" "$out"

        fi

    }

    self_test_assert_version() {
        label=$1
        shift

        if out=$( (parse_args "$@") 2>&1 ); then

            self_test_assert_eq "$label" "$out" "CIDRnt v$VERSION-$BRANCH" "version"

        else

            self_test_fail "$label"

        fi

    }

    need_cmd awk || die "awk is required"

    need_cmd sort || die "sort is required"

    need_cmd diff || die "diff is required"

    mkdir -p "$TMPDIR"

    fail=0

    self_test_section "option parsing"

    self_test_parse_state "option parsing (--allocated-only)" STATUS_MODE "allocated-only" --allocated-only NZ

    self_test_reset_parse_state

    parse_args -c "1.2.3.0/24,2001:db8::/32" --custom=203.0.113.7 -c "2001:db8::1"

    cat > "$TMPDIR/parse_args_custom_options.want" <<'EOF'
